# Optional defaults for every scan (CLI, cron and worker). Copy to scanner.env.
# Any option of the scanner can be set as SCAN_<OPTION>; key=value on the command line still wins.
# Full list: ./scan help

# SCAN_PORTS=80,443,8080,8443          # httpx ports (default: 443 with fallback to 80)
# SCAN_THREADS=50                      # httpx threads
# SCAN_RATE_LIMIT=150                  # httpx requests per second
# SCAN_TIMEOUT=10                      # httpx timeout per request (s)
# SCAN_SUBFINDER_MAX_TIME=10           # minutes per domain for passive enumeration
# SCAN_WORDLIST=/config/my-wordlist.txt  # brute-force wordlist (files in ./config are mounted at /config)
# SCAN_RESOLVERS=/config/resolvers.txt   # trusted resolvers for dnsx + httpx
# SCAN_PROXY=socks5://127.0.0.1:9050
