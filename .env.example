# Copy to .env and adjust. docker compose reads it automatically.

# Where the SQLite database and raw scan output are stored (bind mount).
DATA_DIR=./data

# Dashboard listen address on the host. Keep 127.0.0.1 and use an SSH tunnel,
# or set 0.0.0.0 together with a user/password below.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Without a password the dashboard only answers to localhost (DNS-rebinding protection).
# List extra hostnames here if you reach it under another name (comma separated, or *).
DASHBOARD_ALLOWED_HOSTS=

# Worker only: automatically re-scan every tracked domain every N hours (0 = off). 168 = weekly.
SCAN_SCHEDULE_HOURS=0

# Base images (e.g. point at a mirror if Docker Hub rate-limits you).
GO_IMAGE=golang:1.26
PY_IMAGE=python:3.13-slim
